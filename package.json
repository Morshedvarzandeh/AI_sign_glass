{
  "name": "clearsign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible speech and meeting captions, plus experimental ASL letter recognition from camera, live-call video, and local recordings into reviewed text or speech.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup:model": "node scripts/download-model.mjs",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:video": "node tests/video.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
